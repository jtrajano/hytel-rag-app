{
  "name": "@repo/functions",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./router": "./src/trpc/router.ts"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "serve": "tsx watch --env-file ../../.env.local src/server.ts",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@repo/shared": "workspace:*",
    "@trpc/server": "^11.0.0-rc.660",
    "@google-cloud/bigquery": "^7.0.0",
    "@google-cloud/firestore": "^7.3.0",
    "@google-cloud/vertexai": "^1.9.0",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "google-auth-library": "^9.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@repo/config": "workspace:*",
    "@repo/eslint-config": "workspace:*",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "eslint": "^8.57.0",
    "tsx": "^4.19.2",
    "typescript": "5.5.4",
    "vitest": "^2.1.8"
  }
